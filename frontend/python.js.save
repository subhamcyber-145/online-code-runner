let editor;

require.config({

    paths: {

        vs:
"https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs"

    }

});

require(

    ["vs/editor/editor.main"],

    function () {

        editor =
        monaco.editor.create(

            document.getElementById(
                "editor"
            ),

            {

                value:

                localStorage.getItem(
                "pythonCode"
                )

                ||

                `print("Hello World")`,

                language: "python",

                theme: "vs-dark",

                automaticLayout: true,

                fontSize: 15
            }
        );
    }
);

                editor.onDidChangeModelContent(

                    function () {

                        localStorage.setItem(

                            "pythonCode",

                            editor.getValue()
                        );
                    }
                );

async function runCode() {

    const output =
    document.getElementById(
        "output"
    );

    const runButton =
    document.getElementById(
        "run-btn"
    );

    const code =
    editor.getValue();

    output.style.color =
    "#58a6ff";

    output.textContent =

"[ RUNNING ]\n\nExecuting code...";

    runButton.disabled = true;

    runButton.textContent =
    "Running...";

    try {

       const startTime =
       performance.now();


        const response =
        await fetch(

            "http://127.0.0.1:5000/run",

            {

                method: "POST",

                headers: {

                    "Content-Type":
                    "application/json"
                },

                body: JSON.stringify({

                    code: code,

                    language: "python"
                })
            }
        );

        const data =
        await response.json();

       const endTime =
       performance.now();

       const executionTime = (

           (endTime - startTime)

           / 1000

       ).toFixed(2);

        if (

            data.output
            .toLowerCase()
            .includes("error")

        ) {

            output.style.color =
            "#ff6b6b";

            output.textContent =

                "[ ERROR ]\n\n"

                +

                data.output;
        }

        else {

            output.style.color =
            "#f0f6fc";

            output.textContent =

                "[ SUCCESS ]\n\n"
                data.output

                `\n\nExecuted in ${executionTime}s`;
        }

    }

    catch (error) {

        output.style.color =
        "#ff6b6b";

        output.textContent =

"[ BACKEND ERROR ]\n\nCould not connect to execution server.";
    }

    runButton.disabled = false;

    runButton.textContent =
    "Run";
}

function saveFile() {

    const code =
    editor.getValue();

    const blob =
    new Blob(

        [code],

        {

            type: "text/x-python"
        }
    );

    const url =
    URL.createObjectURL(
        blob
    );

    const a =
    document.createElement("a");

    a.href = url;

    a.download = "main.py";

    document.body.appendChild(a);

    a.click();

    document.body.removeChild(a);

    URL.revokeObjectURL(
        url
    );
}

document.addEventListener(

    "keydown",

    function (e) {

        if (

            e.ctrlKey

            &&

            e.key === "Enter"

        ) {

            e.preventDefault();

            runCode();
        }

        if (

            e.ctrlKey

            &&

            e.key.toLowerCase() === "s"

        ) {

            e.preventDefault();

            saveFile();
        }
    }
);
